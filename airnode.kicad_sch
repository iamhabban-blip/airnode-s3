  (text "ESP32-S3 MCU (native USB)" (at 161.29 113.03 0)
    (effects (font (size 2 2) bold) (justify left bottom))
    (uuid 458e8cda-e555-5ba1-a119-a5a7be70073b)
  )
  (text "BME280 in I2C mode (CSB high), SDO low -> address 0x76. Qwiic pinout: GND, 3V3, SDA, SCL."
    (at 304.8 142.24 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 47b7b889-69ce-5ada-9b74-75a459007f84)
  )
  (text "GPIO19/20 = native USB D-/D+ (flashing + CDC serial, no USB-UART chip).\nIO0 low at reset = download mode."
    (at 162.56 254 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 4a369cd3-cd80-5866-815a-ad564b1fdd2c)
  )
  (text "STATUS LEDS" (at 21.59 224.79 0)
    (effects (font (size 2 2) bold) (justify left bottom))
    (uuid 82597d25-e649-5e77-9838-bceebb14a15b)
  )
  (text "CC1/CC2 5.1k pull-downs = USB-C sink, up to 5V/3A advertised.\nUSBLC6 clamps ESD on D+/D- right at the connector."
    (at 22.86 142.24 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 846ca5f3-2578-5be6-9495-69e2fcb4475d)
  )
  (text "3.3 V LDO REGULATOR" (at 161.29 39.37 0)
    (effects (font (size 2 2) bold) (justify left bottom))
    (uuid b1d98375-cd35-5f5c-874a-079a9ccb316d)
  )
  (text "AP2112K: 600mA LDO, 250mV dropout. ESP32-S3 Wi-Fi TX peaks ~355mA."
    (at 162.56 93.98 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid b4a1317e-03a5-541c-8ea0-f336928051c0)
  )
